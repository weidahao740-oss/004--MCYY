APP_ENV=development
WEB_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:8787

# --- 存储驱动（Web 优先阶段本地持久化）---
# STORE_DRIVER=sqlite（默认，本地 SQLite 持久化）| memory（干净测试，重启即丢）
STORE_DRIVER=sqlite
# SQLITE_PATH：SQLite 文件位置；留空则固定写到项目内 <english-pet>/.data/english-pet.db
# （基于代码位置解析，不依赖运行 cwd；首次启动自动建目录与建表）
SQLITE_PATH=
# ASR 显式驱动：mock（默认）| qwen（仅当显式设为 qwen 才走真实百炼 qwen3-asr-flash）
AI_ASR_PROVIDER=mock

# PostgreSQL 标准连接串；staging/production 由服务端环境注入真实值并强制 TLS。
DATABASE_URL=postgresql://user:password@localhost:5432/english_pet
# CloudBase 上海 PostgreSQL 模式。客户端不得持有以下服务端配置。
CLOUDBASE_ENV_ID=
CLOUDBASE_REGION=ap-shanghai
CLOUDBASE_SECRET_ID=
CLOUDBASE_SECRET_KEY=
CLOUDBASE_STATIC_BUCKET=
CLOUDBASE_TEMP_AUDIO_BUCKET=
ASSET_CDN_BASE_URL=
TEMP_AUDIO_TTL_SECONDS=3600
JWT_SECRET=

# --- AI: 对话模型（OpenAI 兼容端点，任意供应商可切换）---
# 示例 base_url:
#   OpenAI        https://api.openai.com/v1
#   DeepSeek      https://api.deepseek.com/v1
#   Kimi          https://api.moonshot.cn/v1
#   火山方舟      https://ark.cn-beijing.volces.com/api/v3
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- AI: 语音识别 ASR（首选阿里云百炼 qwen3-asr-flash）---
# DASHSCOPE_API_KEY 只配置在服务端环境中，不得提交真实值。
DASHSCOPE_API_KEY=
QWEN_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_ASR_MODEL=qwen3-asr-flash
# 以下为其他 OpenAI multipart 兼容供应商的保留配置；不用于 qwen3-asr-flash。
ASR_API_BASE_URL=
ASR_API_KEY=
ASR_MODEL=

# --- AI: 语音合成 TTS（OpenAI 兼容 /audio/speech 端点）---
TTS_API_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=
TTS_SPEED=1

OBJECT_STORAGE_BUCKET=
